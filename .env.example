# Optional. The observer remains a no-op when Opik is unavailable.
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_PROJECT_NAME=llm-observability-reference

# LLM payload capture is opt-in for the example.
OPIK_CAPTURE_LLM_IO=false

# Used only to opt in to the local integration test.
OPIK_ENABLED=false
